@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(MPI REQUIRED COMPONENTS CXX)

set(dsDecomp_WITH_CUDA @DSDECOMP_ENABLE_CUDA@)
set(dsDecomp_WITH_NCCL @DSDECOMP_ENABLE_NCCL@)
set(dsDecomp_WITH_NVSHMEM @DSDECOMP_ENABLE_NVSHMEM@)
if(dsDecomp_WITH_CUDA)
    find_dependency(CUDAToolkit REQUIRED)
endif()
if(dsDecomp_WITH_NCCL OR dsDecomp_WITH_NVSHMEM)
    list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
endif()
if(dsDecomp_WITH_NCCL)
    find_dependency(NCCL REQUIRED MODULE)
endif()
if(dsDecomp_WITH_NVSHMEM)
    find_dependency(NVSHMEM REQUIRED MODULE)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/dsDecompTargets.cmake")
check_required_components(dsDecomp)
